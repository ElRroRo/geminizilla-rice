{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Logo: truecolor half-block render of the Neo-Tokyo Godzilla plate.
  // Swap variants with:  Set-GodzillaLogo bust | full
  // Regenerate from art:  python ansiart.py && python compose.py   (this folder)
  // NOTE: fastfetch does not expand ~ or env vars here — use an absolute path.
  // Point this at wherever you drop godzilla.ans (see README).
  "logo": {
    "type": "file-raw",
    "source": "C:/Users/YOU/.config/fastfetch/godzilla.ans",
    "width": 66,
    "height": 25,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": " 󰄾 ",
    "key": { "width": 9 },
    "color": {
      "keys": "38;2;255;0;135",
      "title": "38;2;0;240;255",
      "output": "38;2;240;244;248",
      "separator": "38;2;73;84;112"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;255;0;135",
        "yellow": "38;2;255;230;0",
        "red": "38;2;255;23;68"
      }
    },
    "bar": {
      "char": { "elapsed": "█", "total": "░" },
      "border": { "left": "", "right": "" },
      "width": 12
    }
  },

  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;73;84;112m╭\u001b[0m\u001b[38;2;255;0;135m██\u001b[0m\u001b[38;2;73;84;112m─\u001b[0m \u001b[38;2;255;0;135mS Y S T E M   T E L E M E T R Y\u001b[0m \u001b[38;2;73;84;112m──────────────────────────────\u001b[0m"
    },
    { "type": "title", "keyColor": "38;2;255;0;135", "format": "\u001b[38;2;255;0;135m{user-name}\u001b[38;2;73;84;112m@\u001b[38;2;0;240;255m{host-name}\u001b[0m" },

    { "type": "custom", "format": "\u001b[38;2;73;84;112m│\u001b[0m" },

    { "type": "os",       "key": "󰍹 OS",     "keyColor": "38;2;255;0;135" },
    { "type": "host",     "key": "󰌢 Host",   "keyColor": "38;2;255;0;135" },
    { "type": "kernel",   "key": "󰻀 Kernel", "keyColor": "38;2;255;0;135" },
    { "type": "uptime",   "key": "󰅐 Uptime", "keyColor": "38;2;255;0;135" },

    { "type": "custom", "format": "\u001b[38;2;73;84;112m│\u001b[0m" },

    { "type": "shell",    "key": "󰆍 Shell", "keyColor": "38;2;0;240;255" },
    { "type": "terminal", "key": "󰆍 Term",  "keyColor": "38;2;0;240;255" },
    { "type": "packages", "key": "󰏖 Pkgs",  "keyColor": "38;2;0;240;255" },
    { "type": "localip",  "key": "󰩠 Net",   "keyColor": "38;2;0;240;255", "showIpv6": false },

    { "type": "custom", "format": "\u001b[38;2;73;84;112m│\u001b[0m" },

    { "type": "cpu",     "key": "󰻠 CPU",   "keyColor": "38;2;255;0;135" },
    { "type": "gpu",     "key": "󰢮 GPU",   "keyColor": "38;2;255;0;135" },
    { "type": "memory",  "key": "󰍛 RAM",   "keyColor": "38;2;255;0;135" },
    { "type": "disk",    "key": "󰋊 Disk",  "keyColor": "38;2;255;0;135", "folders": "C:" },
    { "type": "battery", "key": "󰁹 Power", "keyColor": "38;2;255;0;135" },

    { "type": "custom", "format": "\u001b[38;2;73;84;112m│\u001b[0m" },
    {
      "type": "custom",
      "format": "\u001b[38;2;73;84;112m╰\u001b[0m\u001b[38;2;255;0;135m██\u001b[0m\u001b[38;2;73;84;112m─\u001b[0m \u001b[38;2;255;230;0m⚡\u001b[0m \u001b[38;2;255;0;135mKAIJU PROTOCOL\u001b[0m \u001b[38;2;73;84;112m──────────────────────────────\u001b[0m"
    },
    "break",
    { "type": "colors", "symbol": "block", "block": { "width": 4 } }
  ]
}
